{
  "name": "sonar-sandbox-app",
  "version": "0.1.0",
  "private": true,
  "description": "Intentionally defective Angular + Express app. Scan target for sonar-remediation-automation.",
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace=web",
    "test": "npm run test --workspace=api && npm run test --workspace=web",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "start:api": "npm run start --workspace=api",
    "test:scripts": "node --test .github/scripts/pr-gate.test.mjs",
    "smells:verify": "node smells/verify-catalogue.mjs",
    "smells:generate": "node smells/generate-catalogue.mjs",
    "test:coverage": "npm run test:coverage --workspace=api && npm run test:coverage --workspace=web",
    "diagram": "node tools/pipeline-diagram/generate-ir.mjs",
    "diagram:check": "node tools/pipeline-diagram/generate-ir.mjs --check",
    "test:diagram": "node --test tools/pipeline-diagram/generate-ir.test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "typescript-eslint": "^8.68.0",
    "yaml": "^2.9.0"
  }
}
